        <mxCell id="node_tier2" value="&lt;b style='color:#92400E; font-size: 12px;'&gt;LEVEL 2: WASPADA (1.05 ≤ RR &amp;lt; 1.30)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569; font-size: 11px;'&gt;Larva inspection &amp;amp; Abate distribution&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontColor=#92400E;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="box_stage4">
