        <mxCell id="banner" value="&lt;b style='font-size: 22px; color: #181818;'&gt;SENTRY PREDICTIVE EPIDEMIOLOGY PIPELINE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 13px; color: #645E54;'&gt;Distributed Lag Non-Linear Modeling (DLNM) &amp;amp; Prescriptive Healthcare Orchestration Architecture&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E0D8;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
