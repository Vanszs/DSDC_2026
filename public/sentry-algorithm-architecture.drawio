        <mxCell id="node_lag_builder" value="&lt;b style='color:#134E4A; font-size: 13px;'&gt;Cross-Basis Matrix Builder&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569; font-size: 11px;'&gt;• 14-Day Lag Transformation&lt;br&gt;• B-Spline Knot Allocation&lt;br&gt;• Natural Cubic Splines (df=4)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#0D9488;strokeWidth=2;fontColor=#134E4A;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="box_stage2">
