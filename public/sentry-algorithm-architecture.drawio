        </mxCell>

        <mxCell id="node_feature_store" value="&lt;b style='color:#0F766E; font-size: 13px;'&gt;Curated Feature Tensor Store&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569; font-size: 11px;'&gt;Multi-dimensional Tensors:&lt;br&gt;[District_ID × Day × Metric × Lag(0..14)]&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=2;fontColor=#134E4A;align=center;shadow=1;" vertex="1" parent="box_stage2">
          <mxGeometry x="20" y="520" width="260" height="120" as="geometry" />
        </mxCell>

        <!-- ========================================================================= -->
        <!-- CONTAINER 3: DLNM MODELING CORE (EMERALD / GREEN THEME)                   -->
        <!-- ========================================================================= -->
        <mxCell id="box_stage3" value="&lt;b style='font-size: 14px; color: #065F46;'&gt;3. DLNM ALGORITHMIC CORE&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;rounded=1;arcSize=8;fontColor=#065F46;collapsible=0;container=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="140" width="300" height="840" as="geometry" />
        </mxCell>

        <mxCell id="node_exposure_func" value="&lt;b style='color:#064E3B; font-size: 13px;'&gt;Exposure-Response Function f(x)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569; font-size: 11px;'&gt;Non-linear pathogen growth curves:&lt;br&gt;• Aedes egg-to-adult incubation&lt;br&gt;• Viral replication threshold&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontColor=#064E3B;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="box_stage3">
          <mxGeometry x="20" y="60" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="node_lag_func" value="&lt;b style='color:#064E3B; font-size: 13px;'&gt;Lag-Response Function w(l)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569; font-size: 11px;'&gt;Temporal decay &amp;amp; delayed surge:&lt;br&gt;• Lag range: 0 ≤ l ≤ 14 days&lt;br&gt;• Peak risk identification (T+6..T+8)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontColor=#064E3B;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="box_stage3">
          <mxGeometry x="20" y="180" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="node_bi_dlnm" value="&lt;b style='color:#064E3B; font-size: 13px;'&gt;Cross-Basis Bi-Dimensional Surface&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569; font-size: 11px;'&gt;s(x_t, l) = ∑∑ α_ij · b_i(x_t) · c_j(l)&lt;br&gt;Joint exposure-lag optimization&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#064E3B;align=center;shadow=1;" vertex="1" parent="box_stage3">
          <mxGeometry x="20" y="300" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="node_ensemble" value="&lt;b style='color:#064E3B; font-size: 13px;'&gt;Quasi-Poisson GAM Ensemble&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569; font-size: 11px;'&gt;• Overdispersion adjustment&lt;br&gt;• Seasonality / Holiday controls&lt;br&gt;• 95% Confidence Interval Band&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontColor=#064E3B;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="box_stage3">
          <mxGeometry x="20" y="420" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="node_pred_engine" value="&lt;b style='color:#065F46; font-size: 13px;'&gt;14-Day Forward Forecast Engine&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569; font-size: 11px;'&gt;Outputs relative risk RR(t+1..14)&lt;br&gt;for each of 16 Sub-districts&lt;/span&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#A7F3D0;strokeColor=#047857;strokeWidth=2;fontColor=#064E3B;align=center;shadow=1;" vertex="1" parent="box_stage3">
          <mxGeometry x="20" y="540" width="260" height="90" as="geometry" />
        </mxCell>

