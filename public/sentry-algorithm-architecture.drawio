        <mxCell id="node_smooth" value="&lt;b style='color:#134E4A; font-size: 13px;'&gt;Spatial-Temporal Alignment&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569; font-size: 11px;'&gt;• Daily Resampling &amp;amp; Sync&lt;br&gt;• Spatial ID Standard Mapping&lt;br&gt;• Rolling Window Smoothing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontColor=#134E4A;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="box_stage2">
