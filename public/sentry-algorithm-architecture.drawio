        <!-- ========================================================================= -->
        <mxCell id="box_stage4" value="&lt;b style='font-size: 14px; color: #92400E;'&gt;4. RISK THRESHOLD ENGINE&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;rounded=1;arcSize=8;fontColor=#92400E;collapsible=0;container=1;" vertex="1" parent="1">
