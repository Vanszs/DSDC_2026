        <mxCell id="node_tier3" value="&lt;b style='color:#1E40AF; font-size: 12px;'&gt;LEVEL 3: SIAGA (1.30 ≤ RR &amp;lt; 1.70)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569; font-size: 11px;'&gt;Targeted fogging &amp;amp; Bed preparation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="box_stage4">
