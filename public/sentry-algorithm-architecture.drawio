        <mxCell id="node_clean" value="&lt;b style='color:#134E4A; font-size: 13px;'&gt;Outlier &amp;amp; Anomaly Filter&lt;/b&gt;&lt;br&gt;&lt;span style='color:#475569; font-size: 11px;'&gt;• Sensor Drift Isolation&lt;br&gt;• Missing Imputation (MICE)&lt;br&gt;• Z-Score Boundary Check&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontColor=#134E4A;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="box_stage2">
          <mxGeometry x="20" y="80" width="260" height="90" as="geometry" />
