  <!-- LANGKAH 1 -->
  <diagram id="step-1" name="1. Mendapatkan Data">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="500" background="#FAF8F5">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="h1" value="&lt;b style='font-size: 16px; color: #1E3A8A;'&gt;LANGKAH 01: BAGAIMANA KITA MENDAPATKAN DATA IKLIM?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1.5;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="920" height="45" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="&lt;b style='font-size:13px; color:#1E3A8A;'&gt;⛅ Open-Meteo API&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px; color:#64748B;'&gt;Suhu, Hujan, Kelembapan, Angin&lt;/span&gt;" style="shape=mxgraph.aws4.cloud;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b style='font-size:13px; color:#1E3A8A;'&gt;📅 Rekam Jejak 30 Tahun&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px; color:#64748B;'&gt;11.688 Hari Cuaca Kota Semarang&lt;/span&gt;" style="shape=mxgraph.aws4.calendar;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="185" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b style='font-size:13px; color:#92400E;'&gt;🗺️ Ketinggian Topografi&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px; color:#64748B;'&gt;Pantai (0 mdpl) s.d. Bukit (350 mdpl)&lt;/span&gt;" style="shape=mxgraph.aws4.map;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="275" width="220" height="75" as="geometry" />
        </mxCell>

        <mxCell id="ts_pipe" value="&lt;b style='font-size:16px; color:#1E3A8A;'&gt;Pengunduh Otomatis&lt;/b&gt;&lt;br&gt;&lt;b style='font-size:12px; color:#3B82F6;'&gt;Sinkronisasi Tiap Jam&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:11px; color:#0F172A;'&gt;Tanpa input manual, sistem mengunduh data cuaca terkini dan prakiraan 14 hari ke depan.&lt;/span&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="360" y="125" width="260" height="200" as="geometry" />
        </mxCell>

        <mxCell id="db_raw" value="&lt;b style='font-size:15px; color:#FFFFFF;'&gt;Database PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px; color:#93C5FD;'&gt;Penyimpanan Terpusat&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b style='font-size:11px; color:#10B981;'&gt;DATA SIAP DIOLAH&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#1E3A8A;strokeColor=#3B82F6;strokeWidth=2.5;align=center;" vertex="1" parent="1">
