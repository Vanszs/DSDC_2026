        <mxCell id="s_bed" value="&lt;b style='font-size:13px; color:#0F172A;'&gt;🛏️ Kesiapan Rumah Sakit &amp;amp; Faskes&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px; color:#2563EB; font-weight:600;'&gt;Penyiapan Ranjang &amp;amp; Stok Obat&lt;/span&gt;&lt;br&gt;&lt;br&gt;Puskesmas siap siaga sebelum bangsal penuh." style="shape=mxgraph.cisco.buildings.hospital;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=2;align=center;" vertex="1" parent="1">
