        <mxCell id="s_psn" value="&lt;b style='font-size:13px; color:#0F172A;'&gt;🧹 PSN 3M+ &amp;amp; Pembagian Abate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px; color:#059669; font-weight:600;'&gt;Membersihkan Genangan Air&lt;/span&gt;&lt;br&gt;&lt;br&gt;Membasmi jentik nyamuk sebelum menetas." style="shape=mxgraph.aws4.shield;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=2;align=center;" vertex="1" parent="1">
